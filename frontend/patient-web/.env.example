# Base URL of the backend API.
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Used only by scripts/generate-sitemap.mjs / prerender (build-time scripts):
# the public origin sitemap.xml URLs should point at.
VITE_SITE_ORIGIN=https://example.com

# Google Maps JavaScript API key — powers the address map picker
# (components/address/AddressMapPicker.tsx). Enable the Maps JavaScript, Places
# and Geocoding APIs and restrict the key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# Store listings used by the "Get the app" QR code / widget.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
