# Base URL of the backend API (see backend/.env PORT and the /api/v1 prefix).
# Point this at a tunnel to use the API from a phone or another machine, and
# remember to add that frontend's own origin to the backend's CORS_ORIGIN.
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Public origin of the patient-facing website (used to build landing-page preview links).
VITE_WEBSITE_ORIGIN=https://www.example.com
