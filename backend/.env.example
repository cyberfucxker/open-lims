# ---------------------------------------------------------------------------
# Open LIMS backend configuration. Copy to `backend/.env` and fill in values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
# 5000 is often taken by macOS AirPlay Receiver — 5001 avoids the clash.
PORT=5001

# Database (PostgreSQL). The docker-compose.yml at the repo root starts a
# matching local database.
DATABASE_URL="postgresql://lims_user:change-me@localhost:5432/open_lims?schema=public"

# CORS — comma-separated list of every frontend origin (admin 3000, superadmin
# 3100, patient-web 3200 in development). A browser sends the Origin exactly as
# typed, so each spelling needs its own entry. In production this must NOT
# contain localhost (the API refuses to boot).
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:3200,http://127.0.0.1:3000,http://127.0.0.1:3100,http://127.0.0.1:3200

# Logging: error | warn | info | http | debug
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Staff auth (admin + franchise portal)
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each of the three JWT secrets and per environment.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30
BCRYPT_SALT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Patient App module
JWT_APP_ACCESS_SECRET=
JWT_APP_ACCESS_EXPIRES_IN=30d
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Phlebotomist (sample collector) App module
JWT_PHLEBO_ACCESS_SECRET=
JWT_PHLEBO_ACCESS_EXPIRES_IN=30d

# Initial admin account created by `npm run prisma:seed -w backend`.
# If SEED_ADMIN_PASSWORD is empty a random password is generated and printed once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Set to true to also seed the sample parameter/test/package catalogue.
SEED_CATALOGUE=false

# Razorpay payment gateway — leave blank in dev; payment routes fail fast until
# keys are set. (Keys can also be managed from Superadmin -> Settings.)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS gateway (OTP + order notifications). Only used when NODE_ENV=production.
SMS_API_URL=
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=
SMS_DLT_ENTITY_ID=
SMS_DLT_CONTENT_ID=
SMS_TIMEOUT_MS=10000
SMS_MAX_RETRIES=2
# Comma-separated head-office numbers alerted on every new booking (optional).
SMS_ORDER_ALERT_NUMBERS=

# Firebase Cloud Messaging (push notifications) — from a service-account JSON
# (Firebase console -> Project settings -> Service accounts). FIREBASE_PRIVATE_KEY
# must keep its literal \n sequences (do not insert real newlines).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional third-party partner-lab report bridge (see
# src/constants/thirdPartyLab.constants.ts). Leave blank unless you integrate one.
THIRD_PARTY_LAB_ORIGIN=
THIRD_PARTY_LAB_BASE_URL=
THIRD_PARTY_LAB_ID=

# Sitemap generation. Leave SITEMAP_OUTPUT_DIR blank in dev (regeneration is
# skipped). In production point it at the folder that serves the patient-web build.
SITEMAP_OUTPUT_DIR=
SITEMAP_SITE_ORIGIN=https://example.com

# WhatsApp AI assistant — see docs/MODULES.md. 32 random bytes, base64:
#   openssl rand -base64 32
# REQUIRED in production. Encrypts keys saved from Superadmin; CHANGING IT makes
# them unreadable (re-enter them afterwards).
WHATSAPP_ENCRYPTION_KEY=
# Public origin of this API (webhook URL display + signed report links).
PUBLIC_API_BASE_URL=
